<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitSwap.ViewModels"
        x:Class="GitSwap.Views.ConfirmSwitchDialog"
        x:DataType="vm:ConfirmSwitchViewModel"
        Title="Confirmar Troca"
        Width="460" Height="475"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,28,28,20" Background="White">
            <StackPanel Spacing="8">
                <TextBlock Text="Visualizar Configuração"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Revise os comandos que serão executados antes de aplicar"
                           FontSize="13" Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Conteudo -->
        <Border Grid.Row="1" Margin="24,20,24,0">
            <StackPanel Spacing="16">

                <!-- Perfil selecionado -->
                <Border Background="White" CornerRadius="12"
                        Padding="18,16" BoxShadow="0 1 3 0 #1A000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PERFIL SELECIONADO"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding ProfileName}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock FontSize="13" Foreground="#64748B">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}  ·  {1}">
                                    <Binding Path="ProfileUserName"/>
                                    <Binding Path="ProfileEmail"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Comandos -->
                <Border Background="White" CornerRadius="12"
                        Padding="18,16" BoxShadow="0 1 3 0 #1A000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="COMANDOS QUE SERÃO EXECUTADOS"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8"/>
                        <Border Background="#F8FAFC" CornerRadius="8"
                                Padding="14,12">
                            <TextBlock Text="{Binding CommandsPreview}"
                                       FontSize="12" Foreground="#334155"
                                       FontFamily="Consolas, Menlo, monospace"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Botoes -->
        <Border Grid.Row="2" Padding="24,20,24,24" Background="White">
            <StackPanel Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        Padding="24,12" FontSize="14" FontWeight="SemiBold"
                        CornerRadius="10"
                        Background="#FEE2E2" Foreground="#DC2626"
                        BorderBrush="#FECACA" BorderThickness="1"
                        Command="{Binding CancelCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#FECACA"/>
                            <Setter Property="Foreground" Value="#B91C1C"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#F87171"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button x:Name="ConfirmButton"
                        Content="Aplicar"
                        Padding="24,12" FontSize="14" FontWeight="SemiBold"
                        CornerRadius="10"
                        Background="#3B82F6" Foreground="White"
                        Command="{Binding ConfirmCommand}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2563EB"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1D4ED8"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
